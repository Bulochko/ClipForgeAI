[Unit]
Description=Lyra AI Telegram bot
Documentation=https://github.com/Bulochko/Lyra-AI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lyra
Group=lyra
WorkingDirectory=/opt/lyra-ai
EnvironmentFile=/opt/lyra-ai/.env
ExecStart=/usr/bin/node src/bot.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/lyra-ai/data

[Install]
WantedBy=multi-user.target
