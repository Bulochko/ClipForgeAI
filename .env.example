# Telegram bot credentials (from @BotFather)
TELEGRAM_BOT_TOKEN=

# DeepSeek API key (platform.deepseek.com -> API keys)
DEEPSEEK_API_KEY=

# Free-tier providers (optional, each enables its own /model entry)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Per-provider model override, e.g. GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL=
# GROQ_MODEL=
# OPENROUTER_MODEL=
# DEEPSEEK_MODEL=

# Default provider for new chats: agent | gemini | groq | openrouter | deepseek
DEFAULT_PROVIDER=agent

# Image generator model passed to Pollinations (flux, turbo, ...)
IMAGE_MODEL=flux

# Optional proxy for Telegram Bot API, e.g. socks5://127.0.0.1:1080
TELEGRAM_PROXY=

# Delivery mode: polling (works anywhere, no domain) or webhook (VPS behind HTTPS)
MODE=polling
# Required when MODE=webhook
WEBHOOK_URL=
WEBHOOK_PORT=8443
# Random string; Telegram must send it back in X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET=

# Comma-separated chat ids allowed to use the bot (empty = everyone). Learn yours via /id
ALLOWED_CHAT_IDS=

# Requests per chat per minute (protects free-tier quotas). 0 disables the limiter.
RATE_LIMIT_PER_MIN=12

# Voice: STT is Gemini's transcription model, TTS prefers Gemini voices.
# GEMINI_STT_MODEL=gemini-3.5-transcribe
# STT_BACKEND=gemini        # or groq (Whisper), gemini is the default
# TTS_BACKEND=gemini        # or google (translate endpoint fallback)
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_VOICE=Kore
